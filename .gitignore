# ==========================================
# OutBroker - Git Ignore
# ==========================================

# Uploaded media and user-generated files
uploads/*
!uploads/.gitkeep

# Build output
target/
build/
out/

# Compiled Java files
*.class
hs_err_pid*
replay_pid*

# Maven wrapper JAR (downloaded/generated)
.mvn/wrapper/maven-wrapper.jar

# IDE - IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# IDE - Eclipse / Spring Tool Suite
.classpath
.project
.settings/
.springBeans
.sts4-cache/
.apt_generated/
.factorypath

# IDE - NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# IDE - VS Code
.vscode/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Local environment and secrets
.env
.env.*
!.env.example

# Local-only Spring configuration
application-dev.properties
application-local.properties

# Temporary files and backups
*.tmp
*.bak
*.swp
*.swo
*~

# Node.js dependencies
node_modules/